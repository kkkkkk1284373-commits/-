<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>머지 쿠킹 마스터 - 울트라 하이엔드 고화질 에디션</title>
<style>
* {
    box-sizing: border-box;
    user-select: none;
    -webkit-user-select: none;
}
body {
    margin: 0;
    padding: 0;
    background: #020617;
    color: #f8fafc;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    overflow: hidden;
    touch-action: manipulation;
}
#game-container {
    width: 100vw;
    max-width: 480px;
    height: 100vh;
    max-height: 920px;
    background: #0f172a;
    border-radius: 28px;
    box-shadow: 0 30px 60px rgba(0,0,0,0.95);
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    border: 2px solid #334155;
}
.header {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 6px;
    background: #1e293b;
    padding: 8px 10px;
    border-radius: 14px;
    margin-bottom: 6px;
    border: 1px solid #475569;
}
.header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.currency-box {
    display: flex;
    gap: 8px;
    font-size: 11px;
    font-weight: 800;
}
.coin-display { color: #fbbf24; }
.gem-display { color: #f472b6; }
.exp-display { color: #38bdf8; }
.top-btns {
    display: flex;
    gap: 4px;
}
.menu-btn {
    padding: 5px 8px;
    background: #334155;
    color: #f8fafc;
    border: 1px solid #64748b;
    border-radius: 6px;
    font-weight: 700;
    font-size: 10px;
    cursor: pointer;
    transition: background 0.2s;
}
.menu-btn:active { background: #475569; }
.customer-area {
    width: 100%;
    background: #1e293b;
    border: 2px dashed #64748b;
    border-radius: 10px;
    padding: 6px 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}
.customer-info {
    display: flex;
    align-items: center;
    gap: 8px;
}
.customer-avatar {
    width: 32px; height: 32px;
    background: #334155; border-radius: 50%;
    display: flex; justify-content: center; align-items: center;
    font-size: 14px; font-weight: 900; color: #38bdf8;
    flex-shrink: 0;
}
.customer-speech .title { font-size: 8px; color: #94a3b8; font-weight: 700; }
.customer-speech .order { font-size: 10px; color: #60a5fa; font-weight: 900; }
.customer-right {
    display: flex; flex-direction: column; align-items: flex-end; gap: 3px;
}
.reward-badge {
    background: #831843; color: #f472b6;
    padding: 2px 5px; border-radius: 4px; font-size: 8px; font-weight: 800;
}
.btn-group {
    display: flex; gap: 4px;
}
.goto-btn {
    padding: 2px 5px; background: #0284c7; color: #f0fdf4;
    border: 1px solid #38bdf8; border-radius: 4px; font-size: 9px; font-weight: 800; cursor: pointer;
}
.skip-btn {
    padding: 2px 5px; background: #991b1b; color: #fecaca;
    border: 1px solid #dc2626; border-radius: 4px; font-size: 9px; font-weight: 800; cursor: pointer;
}
.grid-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(6, 1fr);
    gap: 5px;
    width: 100%;
    aspect-ratio: 1;
    padding: 8px;
    border-radius: 16px;
    margin-bottom: 6px;
    border: 2px solid rgba(255,255,255,0.15);
    transition: background 0.3s ease;
}
.slot {
    background: rgba(15, 23, 42, 0.6);
    border-radius: 6px;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    border: 1px solid rgba(255,255,255,0.1);
    overflow: hidden;
}
.item {
    width: 92%;
    height: 92%;
    border-radius: 6px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    font-weight: 900;
    color: #fff;
    box-shadow: 0 3px 6px rgba(0,0,0,0.5);
    cursor: grab;
    position: absolute;
    z-index: 10;
    text-shadow: 0 1px 2px rgba(0,0,0,0.9);
    font-size: 8px;
    text-align: center;
    padding: 1px;
    touch-action: none;
    border: 1px solid rgba(255,255,255,0.3);
}
.producer {
    border: 2px dashed #fbbf24;
    background: linear-gradient(135deg, #78350f, #451a03) !important;
    cursor: pointer !important;
}
.trash-bin {
    width: 100%;
    background: #7f1d1d;
    border: 2px dashed #b91c1c;
    border-radius: 8px;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 10px;
    color: #fee2e2;
    font-weight: 800;
    margin-bottom: 6px;
}
.controls {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.action-btn {
    width: 100%;
    padding: 8px;
    font-size: 11px;
    font-weight: 800;
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 3px 5px rgba(0,0,0,0.4);
    background: #2563eb;
}
.auto-merge-btn { background: #059669 !important; }
.modal {
    display: none;
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(15, 23, 42, 0.96);
    border-radius: 28px;
    z-index: 2000;
    flex-direction: column;
    align-items: center;
    padding: 20px;
}
.modal-header {
    width: 100%; display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 14px; border-bottom: 1px solid #334155; padding-bottom: 10px;
}
.modal-body {
    width: 100%; max-height: 82%; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;
}
.mode-card {
    background: #1e293b;
    border: 1px solid #334155;
    padding: 10px 12px;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    gap: 6px;
}
.shop-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.shop-controls {
    display: flex;
    align-items: center;
    gap: 4px;
}
.shop-input {
    width: 40px;
    background: #0f172a;
    color: #f8fafc;
    border: 1px solid #64748b;
    border-radius: 4px;
    text-align: center;
    font-weight: 900;
    font-size: 11px;
    padding: 3px;
}
.accordion-header {
    background: #1e293b; color: #38bdf8; padding: 10px; border-radius: 8px;
    cursor: pointer; font-weight: 800; font-size: 11px; display: flex; justify-content: space-between; border: 1px solid #334155;
}
.accordion-content { display: none; flex-direction: column; gap: 4px; padding: 6px 0; }
.accordion-content.active { display: flex; }
</style>
</head>
<body>

<div id="game-container">
    <div class="header">
        <div class="header-top">
            <div class="currency-box">
                <span class="coin-display">🪙 <span id="coin-count">500</span></span>
                <span class="gem-display">💎 <span id="gem-count">100</span></span>
                <span class="exp-display">⭐ Lv.<span id="player-lv">1</span> (<span id="player-exp">0</span>/<span id="max-exp">10</span>)</span>
            </div>
            <div class="top-btns">
                <button class="menu-btn" id="open-shop-modal" style="background:#db2777;">🛍️ 상점</button>
                <button class="menu-btn" id="open-mode-modal" style="background:#0284c7;">📜 메뉴</button>
                <button class="menu-btn" id="open-book">도감</button>
                <button class="menu-btn" id="bgm-btn" style="background:#059669;">🔥 BGM</button>
            </div>
        </div>
    </div>
    
    <div class="customer-area" id="customer-area">
        <div class="customer-info">
            <div class="customer-avatar" id="customer-avatar">👨‍🍳</div>
            <div class="customer-speech">
                <div class="title" id="customer-title-text">손님 주문</div>
                <div class="order" id="customer-order-text">주문을 기다리는 중...</div>
            </div>
        </div>
        <div class="customer-right">
            <div class="reward-badge">보상 💎+<span id="customer-reward">3</span></div>
            <div class="btn-group">
                <button class="goto-btn" id="goto-mission-btn">📍바로가기</button>
                <button class="skip-btn" id="skip-mission-btn">스킵</button>
            </div>
        </div>
    </div>

    <div class="grid-container" id="grid">
        <script>for(let i=0; i<36; i++) document.write(`<div class="slot" data-index="${i}"></div>`);</script>
    </div>

    <div class="trash-bin" id="trash-bin">🗑️ 여기에 드래그하여 아이템/생산기 폐기</div>

    <div class="controls">
        <button class="action-btn auto-merge-btn" id="auto-merge-btn">⚡ 6x6 보드판 한 번에 합치기</button>
        <button class="action-btn" id="spawn-btn" style="background:#d97706;">🏭 현재 모드 생산기 작동하기 (클릭)</button>
    </div>

    <div id="shop-modal" class="modal">
        <div class="modal-header">
            <h3>🛍️ 상점 (생산기 레벨선택 & 스킨)</h3>
            <button class="menu-btn" id="close-shop-modal">닫기</button>
        </div>
        <div class="modal-body" id="shop-list"></div>
    </div>

    <div id="mode-modal" class="modal">
        <div class="modal-header"><h3>📜 게임 메뉴 (20가지 요리 모드 선택)</h3><button class="menu-btn" id="close-mode-modal">닫기</button></div>
        <div class="modal-body" id="mode-list"></div>
    </div>

    <div id="book-modal" class="modal">
        <div class="modal-header"><h3>요리 도감 (마스터피스)</h3><button class="menu-btn" id="close-book">닫기</button></div>
        <div class="modal-body" id="book-list"></div>
    </div>
</div>

<script>
const generateDetailedItems = (prefix, specials) => {
    return Array(100).fill(0).map((_, i) => {
        if (specials[i]) return specials[i];
        return `${prefix} 마스터피스 #${i+1}`;
    });
};

const bakeryItems = generateDetailedItems('베이커리', ['밀가루 반죽', '효모 볼', '생식빵', '버터 토스트', '모닝빵', '단팥빵', '소보로빵', '크루아상', '초코 츄러스', '애플 페이스트리']);

const categories = [
    { name: '베이커리', color: '#d97706', boardBg: '#451a03', icon: '🍞', unlockLv: 1, items: bakeryItems },
    { name: '커피', color: '#b45309', boardBg: '#29170b', icon: '☕', unlockLv: 2, items: coffeeItems },
    { name: '휘낭시에', color: '#92400e', boardBg: '#3b1c06', icon: '🧈', unlockLv: 5, items: financierItems },

    { name: '쿠키', color: '#db2777', boardBg: '#500724', icon: '🍪', unlockLv: 30, items: cookieItems },
    { name: '과일', color: '#10b981', boardBg: '#022c22', icon: '🍎', unlockLv: 35, items: fruitItems },
    { name: '초콜릿', color: '#581c87', boardBg: '#3b0764', icon: '🍫', unlockLv: 40, items: chocolateItems },

const unlockedBookItems = new Set();
let coins = 500n, gems = 100n, playerLevel = 1, playerExp = 0, maxExp = 10;
let currentModeCategory = 0; 
let currentOrderCategory = 0, currentOrderLevel = 1, currentOrderReward = 3n, currentOrderExp = 1;

const boards = {};
for(let i=0; i<categories.length; i++) boards[i] = Array(36).fill(null);
boards[0][0] = { type: 'producer', cat: 0, level: 1 };

function getBoard() { return boards[currentModeCategory]; }

function saveGame() {
    const saveData = {
        coins: coins.toString(),
        gems: gems.toString(),
        playerLevel,
        playerExp,
        maxExp,
        currentModeCategory,
        boards: JSON.stringify(boards, (_, v) => typeof v === 'bigint' ? v.toString() : v),
        unlockedBookItems: Array.from(unlockedBookItems),
        unlockedSkins: Array.from(unlockedSkins)
    };
    localStorage.setItem('merge_cooking_save_v2', JSON.stringify(saveData));
}

function loadGame() {
    const saved = localStorage.getItem('merge_cooking_save_v2');
    if (!saved) return;
    try {
        const data = JSON.parse(saved);
        coins = BigInt(data.coins);
        gems = BigInt(data.gems);
        playerLevel = data.playerLevel;
        playerExp = data.playerExp;
        maxExp = data.maxExp;
        currentModeCategory = data.currentModeCategory;
        if (data.boards) {
            const parsedBoards = JSON.parse(data.boards);
            for (let k in parsedBoards) boards[k] = parsedBoards[k];
        }
        if (data.unlockedBookItems) {
            data.unlockedBookItems.forEach(item => unlockedBookItems.add(item));
        }
        if (data.unlockedSkins) {
            data.unlockedSkins.forEach(skin => unlockedSkins.add(skin));
        }
    } catch(e) { console.error('불러오기 실패', e); }
}

const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
let isBgm = true, bgmInterval = null;

function playSound(type) {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
    osc.frequency.setValueAtTime(type === 'buy' ? 523 : type === 'merge' ? 659 : 880, audioCtx.currentTime);
    osc.connect(gain); gain.connect(audioCtx.destination);
    gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
    osc.start(); osc.stop(audioCtx.currentTime + 0.1);
}

function startBGM() {
    clearInterval(bgmInterval);
    const notes = [440, 523, 659, 784]; let idx = 0;
    bgmInterval = setInterval(() => {
        if (!isBgm) return;
        const osc = audioCtx.createOscillator(), gain = audioCtx.createGain();
        osc.frequency.setValueAtTime(notes[idx], audioCtx.currentTime);
        osc.connect(gain); gain.connect(audioCtx.destination);
        gain.gain.setValueAtTime(0.02, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.1);
        osc.start(); osc.stop(audioCtx.currentTime + 0.1);
        idx = (idx + 1) % notes.length;
    }, 200);
}
startBGM();

function getActiveItems(catIdx) { return categories[catIdx].items; }
function getDishName(catIdx, lv) { return getActiveItems(catIdx)[lv - 1] || `요리 ${lv}`; }
function checkAndUnlockBook(catIdx, lv) { unlockedBookItems.add(`${catIdx}-${lv}`); saveGame(); }

function generateNewOrder() {
    const unlockedCats = categories.filter(cat => playerLevel >= cat.unlockLv);
    const randCat = unlockedCats[Math.floor(Math.random() * unlockedCats.length)];
    currentOrderCategory = categories.indexOf(randCat);

    const items = getActiveItems(currentOrderCategory);
    let maxAllowedLv = Math.min(items.length, Math.max(1, Math.floor(playerLevel * 0.3) + 1));
    let minAllowedLv = Math.max(1, maxAllowedLv - 2);
    
    currentOrderLevel = Math.floor(Math.random() * (maxAllowedLv - minAllowedLv + 1)) + minAllowedLv;
    currentOrderLevel = Math.min(items.length, Math.max(1, currentOrderLevel));
    
    checkAndUnlockBook(currentOrderCategory, currentOrderLevel);

    currentOrderReward = BigInt(currentOrderLevel * 5 + 10);
    currentOrderExp = Math.max(2, Math.floor(currentOrderLevel * 1.2) + 2);

    document.getElementById('customer-title-text').innerText = `[${randCat.name}] 주문`;
    document.getElementById('customer-order-text').innerText = `${getDishName(currentOrderCategory, currentOrderLevel)} (Lv.${currentOrderLevel})`;
    document.getElementById('customer-reward').innerText = `${currentOrderReward} (⭐+${currentOrderExp})`;
}

function addExp(amt) {
    playerExp += amt;
    while (playerExp >= maxExp) {
        playerExp -= maxExp;
        playerLevel += 1;
        maxExp = Math.floor(maxExp * 1.35) + 6;
        gems += 15n;
        coins += 100n;

        let rewardCatIdx = -1;
        let isFixedReward = false;

        const matchedCatIdx = categories.findIndex(cat => cat.unlockLv === playerLevel);
        if (matchedCatIdx !== -1) {
            rewardCatIdx = matchedCatIdx;
            isFixedReward = true;
        } else {
            const unlockedCats = categories.filter(cat => playerLevel >= cat.unlockLv);
            const randCat = unlockedCats[Math.floor(Math.random() * unlockedCats.length)];
            rewardCatIdx = categories.indexOf(randCat);
        }

        const rewardCat = categories[rewardCatIdx];
        const targetBoard = boards[rewardCatIdx];
        const emptySlots = []; targetBoard.forEach((v, i) => { if (v === null) emptySlots.push(i); });

        let rewardMsg = `🎉 레벨 업! P.Lv.${playerLevel} 달성!\n💎 다이아 +15, 🪙 코인 +100 지급!`;
        if (emptySlots.length > 0) {
            targetBoard[emptySlots[0]] = { type: 'producer', cat: rewardCatIdx, level: 1 };
            rewardMsg += `\n🎁 ${isFixedReward ? '✨ [확정 해금]' : '🎲 [무작위 선물]'} [${rewardCat.name}] 생산기(Lv.1) 지급!`;
        }
        alert(rewardMsg);
    }
    updateUI();
    renderBoard();
    saveGame();
}

function updateUI() {
    document.getElementById('coin-count').innerText = coins.toString();
    document.getElementById('gem-count').innerText = gems.toString();
    document.getElementById('player-lv').innerText = playerLevel;
    document.getElementById('player-exp').innerText = playerExp;
    document.getElementById('max-exp').innerText = maxExp;
    saveGame();
}

function getBestProducer(catIdx) {
    let maxLv = -1;
    boards[catIdx].forEach(item => {
        if (item && item.type === 'producer' && item.cat === catIdx) {
            if (item.level > maxLv) maxLv = item.level;
        }
    });
    return maxLv;
}

function triggerProducer(catIdx, prodLevel) {
    const board = getBoard();
    const emptySlots = []; board.forEach((v, i) => { if (v === null) emptySlots.push(i); });
    if (emptySlots.length === 0) { alert('6x6 보드판이 꽉 찼습니다!'); return; }

    const items = getActiveItems(catIdx);
    const targetLv = Math.min(prodLevel, items.length);
    checkAndUnlockBook(catIdx, targetLv);

    board[emptySlots[0]] = { type: 'dish', cat: catIdx, level: targetLv };
    playSound('buy');
    renderBoard();
    saveGame();
}

function spawnItem() {
    const board = getBoard();
    const emptySlots = []; board.forEach((v, i) => { if (v === null) emptySlots.push(i); });
    if (emptySlots.length === 0) { alert('6x6 보드판이 꽉 찼습니다!'); return; }

    let bestLv = getBestProducer(currentModeCategory);
    if (bestLv === -1) {
        board[emptySlots[0]] = { type: 'producer', cat: currentModeCategory, level: 1 };
        emptySlots.shift();
        if (emptySlots.length === 0) { renderBoard(); return; }
        bestLv = 1;
    }

    triggerProducer(currentModeCategory, bestLv);
}

function performAutoMerge() {
    const board = getBoard();
    let merged = false;
    for (let i = 0; i < 36; i++) {
        if (!board[i]) continue;
        for (let j = i + 1; j < 36; j++) {
            if (!board[j]) continue;
            if (board[i].type === board[j].type && board[i].cat === board[j].cat && board[i].level === board[j].level) {
                let maxLv = board[i].type === 'producer' ? 100 : getActiveItems(board[i].cat).length;
                if (board[i].level < maxLv) {
                    board[i].level += 1;
                    checkAndUnlockBook(board[i].cat, board[i].level);
                    board[j] = null;
                    merged = true;
                    break;
                }
            }
        }
    }
    if (merged) { playSound('merge'); renderBoard(); saveGame(); }
    else { alert('합칠 수 있는 동일한 아이템이 없습니다!'); }
}

let draggedItem = null, draggedIndex = null, ghostEl = null;

function renderBoard() {
    const currentCat = categories[currentModeCategory];
    document.getElementById('grid').style.background = currentCat.boardBg;

    const board = getBoard();
    const slots = document.querySelectorAll('.slot');
    slots.forEach((slot, idx) => {
        slot.innerHTML = '';
        const item = board[idx];
        if (item) {
            const el = document.createElement('div');
            el.className = 'item';
            el.dataset.index = idx;
            el.style.backgroundColor = categories[item.cat].color;
            
            if (item.type === 'producer') {
                el.classList.add('producer');
                el.innerHTML = `<span style="font-size:12px;">🏭</span><span style="font-size:6px; color:#fbbf24; font-weight:900;">${categories[item.cat].name} L${item.level}</span>`;
                
                el.addEventListener('click', (e) => {
                    e.stopPropagation();
                    triggerProducer(item.cat, item.level);
                });
            } else {
                const cat = categories[item.cat];
                const name = getDishName(item.cat, item.level);
                const imgUrl = getGeneratedFoodIcon(name, cat.color, item.level, item.cat);
                el.innerHTML = `
                    <img src="${imgUrl}" style="width:24px; height:24px; border-radius:4px; margin-bottom:1px;" />
                    <span style="font-size:6px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; width:100%;">${name}</span>
                    <span style="font-size:5px; opacity:0.85;">Lv.${item.level}</span>
                `;
            }
            
            el.addEventListener('pointerdown', handlePointerDown);
            slot.appendChild(el);
        }
    });
}

function handlePointerDown(e) {
    if (e.target.tagName === 'SPAN' && e.currentTarget.classList.contains('producer')) return;

    draggedItem = e.currentTarget;
    draggedIndex = parseInt(draggedItem.dataset.index);
    const rect = draggedItem.getBoundingClientRect();
    
    ghostEl = draggedItem.cloneNode(true);
    ghostEl.style.position = 'fixed'; ghostEl.style.zIndex = '9999';
    ghostEl.style.pointerEvents = 'none'; ghostEl.style.opacity = '0.85';
    ghostEl.style.width = rect.width + 'px'; ghostEl.style.height = rect.height + 'px';
    document.body.appendChild(ghostEl);
    
    moveGhost(e.clientX, e.clientY);
    window.addEventListener('pointermove', handlePointerMove);
    window.addEventListener('pointerup', handlePointerUp);
}

function handlePointerMove(e) { if (ghostEl) moveGhost(e.clientX, e.clientY); }
function moveGhost(x, y) {
    ghostEl.style.left = (x - ghostEl.offsetWidth / 2) + 'px';
    ghostEl.style.top = (y - ghostEl.offsetHeight / 2) + 'px';
}

function handlePointerUp(e) {
    window.removeEventListener('pointermove', handlePointerMove);
    window.removeEventListener('pointerup', handlePointerUp);
    if (ghostEl) { ghostEl.remove(); ghostEl = null; }

    const elem = document.elementFromPoint(e.clientX, e.clientY);
    if (!elem) { draggedItem = null; return; }

    const board = getBoard();
    if (elem.closest('#customer-area')) {
        const item = board[draggedIndex];
        if (item && item.type === 'dish' && item.cat === currentOrderCategory && item.level === currentOrderLevel) {
            gems += currentOrderReward; coins += BigInt(currentOrderLevel * 30);
            playSound('buy'); board[draggedIndex] = null;
            addExp(currentOrderExp); generateNewOrder(); renderBoard(); updateUI();
            draggedItem = null; return;
        }
    }

    if (elem.closest('#trash-bin')) {
        board[draggedIndex] = null; renderBoard(); updateUI(); draggedItem = null; return;
    }

    const targetSlot = elem.closest('.slot');
    if (targetSlot) {
        const targetIndex = parseInt(targetSlot.dataset.index);
        if (targetIndex !== draggedIndex) {
            const src = board[draggedIndex], tgt = board[targetIndex];
            if (tgt === null) {
                board[targetIndex] = src; board[draggedIndex] = null;
            } else if (tgt.type === src.type && tgt.cat === src.cat && tgt.level === src.level) {
                let maxLv = src.type === 'producer' ? 100 : getActiveItems(src.cat).length;
                if (tgt.level < maxLv) {
                    tgt.level += 1; checkAndUnlockBook(src.cat, tgt.level);
                    board[draggedIndex] = null; playSound('merge');
                }
            } else {
                board[draggedIndex] = tgt; board[targetIndex] = src;
            }
        }
    }
    draggedItem = null; renderBoard(); updateUI();
}


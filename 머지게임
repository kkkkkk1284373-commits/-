            ${isUnlocked ? `
            <div class="shop-row" style="border-top:1px solid #334155; padding-top:6px;">
                <span style="font-size:10px; color:#fbbf24;" id="price-display-${idx}">비용: 💎 10개 (또는 🪙 20코인)</span>
                <div style="display:flex; gap:4px;">
                    <button class="menu-btn" style="background:#db2777;" onclick="buyProducer(${idx}, 'gem')">다이아 구매</button>
                    <button class="menu-btn" style="background:#d97706;" onclick="buyProducer(${idx}, 'coin')">코인 구매</button>
                </div>
            </div>
            ` : `<div style="font-size:10px; color:#ef4444;">잠김</div>`}
        `;
        list.appendChild(card);
    });

    const skinHeader = document.createElement('div');
    skinHeader.innerHTML = `<h4 style="color:#f472b6; margin:12px 0 4px 0;">🎨 테마 스킨 상점</h4>`;
    list.appendChild(skinHeader);

    skins.forEach((skin, sIdx) => {
        const isOwned = unlockedSkins.has(skin.name);
        const card = document.createElement('div');
        card.className = 'mode-card';
        card.innerHTML = `
            <div class="shop-row">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:18px;">✨</span>
                    <div>
                        <div style="font-weight:800; font-size:11px; color:#f8fafc;">${skin.name}</div>
                        <div style="font-size:9px; color:#f472b6;">가격: 💎${skin.priceGem} 또는 🪙${skin.priceCoin}</div>
                    </div>
                </div>
                <div>
                    ${isOwned ? 
                        `<button class="menu-btn" style="background:#059669;" onclick="applySkin('${skin.name}', '${skin.color}')">적용하기</button>` :
                        `<div style="display:flex; gap:4px;">
                            <button class="menu-btn" style="background:#db2777;" onclick="buySkin(${sIdx}, 'gem')">다이아 구매</button>
                            <button class="menu-btn" style="background:#d97706;" onclick="buySkin(${sIdx}, 'coin')">코인 구매</button>
                         </div>`
                    }
                </div>
            </div>
        `;
        list.appendChild(card);
    });
}

function updatePrice(idx) {
    const lv = parseInt(document.getElementById(`level-input-${idx}`).value) || 1;
    const qty = parseInt(document.getElementById(`qty-input-${idx}`).value) || 1;
    const baseGem = 10 * Math.pow(2, lv - 1) * qty;
    const baseCoin = baseGem * 2;
    document.getElementById(`price-display-${idx}`).innerText = `비용: 💎 ${baseGem}개 (또는 🪙 ${baseCoin}코인)`;
}

function buyProducer(idx, currency) {
    const cat = categories[idx];
    const lv = parseInt(document.getElementById(`level-input-${idx}`).value) || 1;
    const qty = parseInt(document.getElementById(`qty-input-${idx}`).value) || 1;

    const gemCost = 10 * Math.pow(2, lv - 1) * qty;
    const coinCost = gemCost * 2;

    if (currency === 'gem' && gems < BigInt(gemCost)) {
        alert(`💎 다이아가 부족합니다! (필요: 💎${gemCost})`); return;
    }
    if (currency === 'coin' && coins < BigInt(coinCost)) {
        alert(`🪙 코인이 부족합니다! (필요: 🪙${coinCost})`); return;
    }

    const targetBoard = boards[idx];
    const emptySlots = []; 
    targetBoard.forEach((v, i) => { if (v === null) emptySlots.push(i); });

    if (emptySlots.length < qty) {
        alert(`[${cat.name}] 6x6 보드판에 빈자리가 부족합니다!`); return;
    }

    if (currency === 'gem') gems -= BigInt(gemCost);
    else coins -= BigInt(coinCost);

    for (let i = 0; i < qty; i++) {
        targetBoard[emptySlots[i]] = { type: 'producer', cat: idx, level: lv };
        checkAndUnlockBook(idx, lv);
    }
    playSound('buy');
    updateUI();
    alert(`🎉 [${cat.name}] Lv.${lv} 생산기 ${qty}개 구매 완료!`);
    document.getElementById('shop-modal').style.display = 'none';
    if (currentModeCategory === idx) renderBoard();
}

function buySkin(sIdx, currency) {
    const skin = skins[sIdx];
    if (currency === 'gem' && gems < BigInt(skin.priceGem)) { alert('💎 다이아가 부족합니다!'); return; }
    if (currency === 'coin' && coins < BigInt(skin.priceCoin)) { alert('🪙 코인이 부족합니다!'); return; }

    if (currency === 'gem') gems -= BigInt(skin.priceGem);
    else coins -= BigInt(skin.priceCoin);

    unlockedSkins.add(skin.name);
    applySkin(skin.name, skin.color);
    updateUI();
    renderShopModal();
    alert(`🎉 [${skin.name}] 구매 및 적용 완료!`);
}

function applySkin(name, color) {
    currentSkinColor = color;
    document.getElementById('game-container').style.borderColor = color;
    alert(`✨ [${name}] 스킨이 적용되었습니다!`);
}

function renderModeModal() {
    const list = document.getElementById('mode-list');
    list.innerHTML = '';
    categories.forEach((cat, idx) => {
        const isUnlocked = playerLevel >= cat.unlockLv;
        const isActive = currentModeCategory === idx;

        const card = document.createElement('div');
        card.className = `mode-card`;
        card.style.flexDirection = 'row';
        card.innerHTML = `
            <div style="display:flex; align-items:center; gap:8px;">
                <span style="font-size:20px;">${cat.icon}</span>
                <div>
                    <div style="font-weight:800; font-size:12px; color:${isUnlocked ? '#f8fafc' : '#64748b'};">${cat.name} 모드</div>
                    <div style="font-size:9px; color:${isUnlocked ? '#38bdf8' : '#ef4444'};">해금 조건: 레벨 ${cat.unlockLv} 이상</div>
                </div>
            </div>
            <button class="menu-btn" style="background:${isActive ? '#059669' : (isUnlocked ? '#2563eb' : '#475569')};">
                ${isActive ? '플레이중' : (isUnlocked ? '선택하기' : '잠김')}
            </button>
        `;

        card.addEventListener('click', () => {
            if (!isUnlocked) { alert(`🔒 레벨 ${cat.unlockLv}이 되어야 해금됩니다!`); return; }
            currentModeCategory = idx;
            document.getElementById('mode-modal').style.display = 'none';
            renderBoard();
            saveGame();
        });
        list.appendChild(card);
    });
}

document.getElementById('open-shop-modal').addEventListener('click', () => {
    renderShopModal();
    document.getElementById('shop-modal').style.display = 'flex';
});
document.getElementById('close-shop-modal').addEventListener('click', () => { document.getElementById('shop-modal').style.display = 'none'; });

document.getElementById('goto-mission-btn').addEventListener('click', () => {
    const targetCat = currentOrderCategory;
    const catObj = categories[targetCat];
    if (playerLevel < catObj.unlockLv) {
        alert(`🔒 미션 테마인 [${catObj.name}] 모드는 레벨 ${catObj.unlockLv}에 해금됩니다!`);
        return;
    }
    currentModeCategory = targetCat;
    renderBoard();
    saveGame();
});

document.getElementById('open-mode-modal').addEventListener('click', () => {
    renderModeModal();
    document.getElementById('mode-modal').style.display = 'flex';
});
document.getElementById('close-mode-modal').addEventListener('click', () => { document.getElementById('mode-modal').style.display = 'none'; });

document.getElementById('open-book').addEventListener('click', () => {
    const list = document.getElementById('book-list'); list.innerHTML = '';
    categories.forEach((cat, cIdx) => {
        const items = getActiveItems(cIdx);
        let unlockedCount = 0;
        items.forEach((_, lIdx) => { if (unlockedBookItems.has(`${cIdx}-${lIdx+1}`)) unlockedCount++; });

        const header = document.createElement('div');
        header.className = 'accordion-header';
        header.innerHTML = `<span>${cat.icon} ${cat.name} 도감 (${unlockedCount}/${items.length})</span> <span>▼ 접기</span>`;
        
        const content = document.createElement('div');
        content.className = 'accordion-content active';
        header.addEventListener('click', () => content.classList.toggle('active'));

        items.forEach((name, lIdx) => {
            const lv = lIdx + 1;
            const isUnlocked = unlockedBookItems.has(`${cIdx}-${lv}`);
            const div = document.createElement('div');
            div.style.cssText = "background:#1e293b; padding:8px; border-radius:8px; display:flex; justify-content:space-between; align-items:center; font-size:11px; border:1px solid #334155;";
            
            if (isUnlocked) {
                const imgUrl = getGeneratedFoodIcon(name, cat.color, lv, cIdx);
                div.innerHTML = `<span style="color:#f8fafc; display:flex; align-items:center; gap:6px;"><img src="${imgUrl}" style="width:20px; height:20px; border-radius:3px;">${name}</span> <span style="color:#38bdf8; font-weight:700;">Lv.${lv}</span>`;
            } else {
                div.innerHTML = `<span style="color:#64748b;">❓ 미발견 요리</span> <span style="color:#64748b;">Lv.${lv}</span>`;
            }
            content.appendChild(div);
        });
        list.appendChild(header); list.appendChild(content);
    });
    document.getElementById('book-modal').style.display = 'flex';
});
document.getElementById('close-book').addEventListener('click', () => { document.getElementById('book-modal').style.display = 'none'; });

document.getElementById('spawn-btn').addEventListener('click', spawnItem);
document.getElementById('auto-merge-btn').addEventListener('click', performAutoMerge);
document.getElementById('skip-mission-btn').addEventListener('click', generateNewOrder);
document.getElementById('bgm-btn').addEventListener('click', () => {
    isBgm = !isBgm;
    document.getElementById('bgm-btn').style.background = isBgm ? '#059669' : '#334155';
    document.getElementById('bgm-btn').innerText = isBgm ? '🔥 BGM' : '🔇 MUTE';
});

loadGame();
generateNewOrder();
renderBoard();
updateUI();
</script>
</body>
</html>
